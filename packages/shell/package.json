{
  "name": "@mine/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/preload.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "electron ."
  },
  "dependencies": {
    "@mine/contracts": "workspace:*",
    "@mine/fetcher": "workspace:*",
    "@mine/media": "workspace:*",
    "@mine/protocol": "workspace:*",
    "@mine/safety": "workspace:*",
    "@mine/search": "workspace:*",
    "@mine/shield": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
